import QrCode from "../src/campfire/qr_code"

private

# A link of the length of a sign-in link: version 7 (four blocks, the version bits), its modules as the independent
# encoder python-qrcode draws them (level M, byte mode, mask 0), one row per text, "1" dark.
LINK = "https://campfire.example.com/session/transfers/" + "ab" * 32
EXPECTED = [
  "111111100111000110011010011001111100101111111",
  "100000101101110001011111011100111101001000001",
  "101110100000100001101111110000100001001011101",
  "101110100110010100011110011001100001101011101",
  "101110101110110010001111110111111111101011101",
  "100000100000101011011000110100110100001000001",
  "111111101010101010101010101010101010101111111",
  "000000000011000100001000110111011101000000000",
  "101010100111100110101111111111111100000010010",
  "110011001000010010001101000100011000010011001",
  "000100100101110011001111000000001001110011011",
  "111000011111001110101001110101001101001110010",
  "001001101011100001100001000010011110000111000",
  "110010000010011110101101100110000000010111011",
  "100110101101011110100111100010011000000010011",
  "001001011100010100000101110111011101010110011",
  "000100101110011111100110111110011000000110001",
  "100111011010100111110011100000011000000001011",
  "101000100101011100100001100010011001000011111",
  "000000001011011111100000010111011100110110000",
  "000011111110101001111111111111011110111110001",
  "100110001110110001111000110111011000100010001",
  "111010101101001011001010111010001001101010111",
  "100010001010011111111000101011011101100010000",
  "110111111010101011001111111110011111111111011",
  "100111011111101001001111000000000001000001011",
  "010001101001001111000010010110001000111101011",
  "111111000001000010001000010111011010111010001",
  "101010101010100101110110111111111000100100010",
  "100001000011111001010110100000011000011001011",
  "000101101110111001100011100010011100001011111",
  "110000000110101011110111010110011100111100000",
  "010011101100100000001111100111111110110000001",
  "111000010100011110001111000111010001101001011",
  "000010101111010010100100000010001000111110011",
  "011110010000011101110110001110111100001100011",
  "100110101011011000001111100111011000111110001",
  "000000001110000010011000101000000000100010011",
  "111111100010100011011010101010001001101010111",
  "100000100011110100001000110111011010100010001",
  "101110101000010000101111101111111111111111001",
  "101110100100110101111010000110011001110111111",
  "101110101100000000001010100100001101111111111",
  "100000100000111001011101110111011101100110010",
  "111111101111010101111101100110011100100010011",
]

def rows_of(code: QrCode.Code) -> List[String]
  (0...code.size).map do |y| (0...code.size).map(->(x) { if_dark(code.dark[y * code.size + x]) }).join("") end
end

def if_dark(dark: Bool) -> String
  return "1" if dark

  "0"
end

def main() -> Void
  Test.run([
    Test.test("a code is the one that another encoder draws") do
      code = try QrCode.encode(LINK.bytes)
      Test.assert(rows_of(code) == EXPECTED, "the modules differ: #{rows_of(code)}")
    end,
    Test.test("the version grows with the bytes, up to version 10") do
      try Test.assert((try QrCode.encode("".bytes)).size == 21, "an empty text is version 1")
      try Test.assert((try QrCode.encode(List.repeat("x", 15).join("").bytes)).size == 25, "15 bytes need version 2")
      Test.assert(
        (try QrCode.encode(List.repeat("x", QrCode.MAX_BYTES).join("").bytes)).size == 57,
        "the most is version 10",
      )
    end,
    Test.test("more bytes than a version 10 code holds are an error") do
      Test.assert(not QrCode.encode(List.repeat("x", QrCode.MAX_BYTES + 1).join("").bytes).ok?, "too long")
    end,
  ])
end
